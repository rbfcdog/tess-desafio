# Supabase URL and publishable (or legacy anon) key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: secret key (or legacy service_role JWT).
SUPABASE_SECRET_KEY=

# Server-only model credentials; choose a Responses model with image/PDF/web support.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_OUTPUT_TOKENS=2048
CONTEXT_INPUT_TOKENS=16000
CONTEXT_WINDOW_TOKENS=128000
SUMMARY_OUTPUT_TOKENS=1500
MAX_MODEL_STEPS=8
MAX_TOOL_CALLS=8
PORT=3001

# Stable private Fernet key for saved tool credentials and Google tokens. Back it up.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:3005
# Explicit remote MCP trust; comma-separated exact public HTTPS hostnames, never '*'.
MCP_TRUSTED_HOSTS=mcp.context7.com

# Google OAuth client configured for Drive/Gmail read-only scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/connectors/google/callback
